# Environment & secrets
.env
*.env
!.env.example

# Python
__pycache__/
*.pyc
venv/
env/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Data (raw/processed data can be large or sensitive — we don't commit it)
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# OS files
.DS_Store
Thumbs.db

# VS Code
.vscode/

# Model artifacts (large binary files — handled separately later)
*.pkl
*.joblib